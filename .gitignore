# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

# Dependencies and build output
node_modules/
.expo/
dist/
coverage/

# Native projects (generated by expo prebuild)
apps/mobile/ios/
apps/mobile/android/

# Signing keys, certificates and secrets
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
*.key
*.crt
*.der
*.p7b
*.provisionprofile
key.properties
.env*

# Editors, logs and temporary files
*~
*.sw[mnpcod]
*.log
*.tmp
*.tmp.*
log.txt
*.sublime-project
*.sublime-workspace
.vscode/
.idea/
.zed
npm-debug.log*
.tmp/
tmp/
temp/

# OS files
$RECYCLE.BIN/
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate

# Claude Code local settings and build info
.claude/settings.local.json
*.tsbuildinfo

# Local brainstorm/mockup files (never commit)
.superpowers/
# Planning docs (specs, plans) — local only, never commit
docs/superpowers/

# Release builds, signing and store credentials (never commit)
*.aab
*.apk
*.ipa
*.xcarchive
*.pem
google-services.json
GoogleService-Info.plist
gradle.properties
keystore.properties
credentials.json
*.keystore.properties
# Store screenshots, raw and framed (the owner uploads them by hand)
apps/mobile/store/
*.pfx
*.cer
*.certSigningRequest
*.dSYM
*service-account*.json
local.properties
apps/mobile/build/
